# ===========================================
# CLICKUP MCP SERVER - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# Do NOT commit .env to version control!

# ===========================================
# REQUIRED CONFIGURATION
# ===========================================

# ClickUp Personal API Token
# Get it from: ClickUp Settings > Apps > API Token
# Format: pk_123456_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLICKUP_API_TOKEN=pk_YOUR_TEAM_ID_YOUR_TOKEN_HERE

# PostgreSQL/Supabase Database Connection String
# Get it from: Supabase Dashboard > Settings > Database > Connection string
# Use the "Transaction Pooler" connection for production (port 6543)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ===========================================
# SLM/LLM PROVIDER CONFIGURATION
# ===========================================

# MCP Server URL (default - change if running on different host/port)
MCP_SERVER_URL=http://127.0.0.1:8001/sse

# OpenRouter settings used by api-server and report generation
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# Report generation mode for motia-reports
# Keep this as llm for the Brevo + PM deployment setup.
REPORT_API_MODE=llm

# Email transport: brevo_api (recommended), smtp, or auto
EMAIL_TRANSPORT=brevo_api
# Brevo API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Sender identity/domain for Brevo transactional emails.
# If using name.com domain, verify/authenticate domain in Brevo and set sender like:
# EMAIL_FROM=reports@yourdomain.com
EMAIL_FROM=
EMAIL_FROM_NAME=Your Name or Company Name


# SMTP fallback settings used when EMAIL_TRANSPORT=smtp
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional: keep report spaces private via secret JSON (shape: {"report_spaces":[...]})
REPORT_SPACES_JSON=

# Optional: trigger helper defaults
MOTIA_TRIGGER_URL=http://localhost:3111/trigger-report
MOTIA_TRIGGER_RETRIES=8
MOTIA_TRIGGER_RETRY_DELAY_S=2

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# ClickUp Team/Workspace ID (auto-detected if not set)
# Find it in URL: https://app.clickup.com/{TEAM_ID}/...
CLICKUP_TEAM_ID=

# ClickUp Space ID (optional - for default filtering)
CLICKUP_SPACE_ID=

# ===========================================
# DEVELOPMENT/DEBUG OPTIONS
# ===========================================

# Enable debug logging (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
