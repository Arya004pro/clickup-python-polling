{
  "name": "clickup-python-polling",
  "version": "1.0.0",
  "scripts": {
    "start": "myenv\\Scripts\\python.exe clickup_mcp/watch-restart.py",
    "dev": "docker compose up --build",
    "dev:detach": "docker compose up --build -d",
    "dev:watch": "docker compose up --build --watch",
    "dev:logs": "docker compose logs -f mcp-server api-server motia-reports",
    "dev:status": "docker compose ps",
    "dev:down": "docker compose down",
    "dev:restart": "docker compose restart",
    "dev:trigger:yesterday": "myenv\\Scripts\\python.exe trigger_reports.py --period yesterday --label \"Manual yesterday run\"",
    "dev:trigger:today": "myenv\\Scripts\\python.exe trigger_reports.py --period today --label \"Manual today run\""
  },
  "description": "Helper scripts for running the MCP server",
  "dependencies": {}
}
