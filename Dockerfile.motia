FROM node:20-slim

# Install system dependencies once to keep build layers lean.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    python3 \
    python3-pip \
    python3-venv \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Install uv (Python package manager used by motia)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"
ENV TZ=Asia/Kolkata

# Install Motia CLI (used by Python worker process inside iii ExecModule)
RUN npm install -g motia@1.0.0-rc.24

# Install iii runtime engine CLI (current binary name: iii)
RUN curl -fsSL https://install.iii.dev/iii/main/install.sh | sh

WORKDIR /app

# Install Python dependencies first (layer caching)
COPY clickup-motia-reports/pyproject.toml clickup-motia-reports/uv.lock ./
RUN uv sync --frozen

# Copy application
COPY clickup-motia-reports/iii-config.yaml .
COPY clickup-motia-reports/steps/ ./steps/

# Ensure 'steps' package is importable from /app
ENV PYTHONPATH=/app

# Data directories for iii state/stream persistence
RUN mkdir -p data/streams_store

# Start iii engine using explicit config.
CMD ["iii", "-c", "iii-config.yaml"]
